APP_MODE=CLOUD_SAAS
NODE_ENV=production

APP_PUBLIC_PORT=80
CORS_ORIGINS=https://app.example.com
BUSINESS_TIMEZONE=UTC
PLATFORM_TENANT_ID=zs
TENANT_ID=zs
ACCOUNT_ID=zs

DATABASE_HOST=your-hosted-db-host
DATABASE_PORT=5432
DATABASE_NAME=zsdb
DATABASE_USER=zs
DATABASE_PASSWORD=change-me-db-password
DATABASE_SCHEMA=public
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_SSL_CA_CERT=

ENABLE_BOOTSTRAP_ADMIN=false
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=strict
SESSION_CSRF_SECRET=replace-me-with-long-random-secret

# Replace the example SMTP values with the provider settings before starting Compose.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Z Systems
